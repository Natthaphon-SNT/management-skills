# Neon pooled URL: hostname มี -pooler; แทน placeholder ด้วยค่าของโครงการ
DATABASE_URL="postgresql://USER:PASSWORD@ep-PROJECT-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=15&connection_limit=3"
# Neon direct URL: hostname ไม่มี -pooler; ใช้กับ Prisma migrate
DIRECT_URL="postgresql://USER:PASSWORD@ep-PROJECT.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
SESSION_SECRET=
ADMIN_INITIAL_PASSWORD=

